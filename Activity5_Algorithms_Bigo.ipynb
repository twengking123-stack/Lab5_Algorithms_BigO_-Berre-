    "# [CELL 6]\n",
    "\n",
    "def search_case(data, target):\n",
    "    for i, value in enumerate(data, 1):\n",
    "        if value == target:\n",
    "            return i\n",
    "\n",
    "    return len(data)\n",
    "\n",
    "\n",
    "data = [11, 22, 33, 44, 55]\n",
    "\n",
    "for case, target in {\n",
    "    \"Best\": 11,\n",
    "    \"Average\": 33,\n",
    "    \"Worst\": 99\n",
    "}.items():\n",
    "    print(f\"{case} Case: {search_case(data, target)} comparisons\")"
   ]
