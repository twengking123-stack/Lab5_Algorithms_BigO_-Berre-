    "# [CELL 13]\n",
    "\n",
    "def insertion_sort(data):\n",
    "    a = data.copy()\n",
    "    comparisons = 0\n",
    "    shifts = 0\n",
    "\n",
    "    for i in range(1, len(a)):\n",
    "        key = a[i]\n",
    "        j = i - 1\n",
    "\n",
    "        while j >= 0:\n",
    "            comparisons += 1\n",
    "\n",
    "            if a[j] <= key:\n",
    "                break\n",
    "\n",
    "            a[j + 1] = a[j]\n",
    "            shifts += 1\n",
    "            j -= 1\n",
    "\n",
    "        a[j + 1] = key\n",
    "\n",
    "    return a, comparisons, shifts\n",
    "\n",
    "\n",
    "insertion_result, insertion_comparisons, insertion_shifts = insertion_sort(data)\n",
    "\n",
    "print(\"Sorted:\", insertion_result)\n",
    "print(\"Comparisons:\", insertion_comparisons)\n",
    "print(\"Shifts:\", insertion_shifts)"
   ]
