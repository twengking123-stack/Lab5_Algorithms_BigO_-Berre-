    "# [CELL 5]\n",
    "\n",
    "def constant_space(n):\n",
    "    total = 0\n",
    "\n",
    "    for value in range(n):\n",
    "        total += value\n",
    "\n",
    "    return total\n",
    "\n",
    "\n",
    "def linear_space(n):\n",
    "    return list(range(n))\n",
    "\n",
    "\n",
    "for n in [10, 100, 1000, 5000]:\n",
    "    data = linear_space(n)\n",
    "    print(f\"n={n:5d} | O(1): constant | O(n): {len(data)}\")"
   ]
