    "# [CELL 4]\n",
    "\n",
    "def log_ops(n):\n",
    "    count = 0\n",
    "\n",
    "    while n > 1:\n",
    "        n //= 2\n",
    "        count += 1\n",
    "\n",
    "    return count\n",
    "\n",
    "\n",
    "for n in [10, 100, 1000]:\n",
    "    print(\n",
    "        f\"n={n:4d} | O(1)=1\"\n",
    "        f\" | O(log n)={log_ops(n):2d}\"\n",
    "        f\" | O(n)={n:4d}\"\n",
    "        f\" | O(n²)={n*n:7d}\"\n",
    "    )"
   ]
  },
