    "# [CELL 7]\n",
    "\n",
    "def linear_search(data, target):\n",
    "    for i, value in enumerate(data):\n",
    "        if value == target:\n",
    "            return i, i + 1\n",
    "\n",
    "    return -1, len(data)\n",
    "\n",
    "\n",
    "data = list(range(1, 21))\n",
    "target = SEED_DIGIT + 1\n",
    "\n",
    "index, comparisons = linear_search(data, target)\n",
    "\n",
    "print(\"Target:\", target)\n",
    "print(\"Index:\", index)\n",
    "print(\"Comparisons:\", comparisons)"
   ]
