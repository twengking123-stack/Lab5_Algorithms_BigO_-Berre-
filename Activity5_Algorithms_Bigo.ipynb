    "# [CELL 10]\n",
    "\n",
    "def bubble_sort(data):\n",
    "    a = data.copy()\n",
    "    comparisons = 0\n",
    "    swaps = 0\n",
    "\n",
    "    for i in range(len(a)):\n",
    "        swapped = False\n",
    "\n",
    "        for j in range(len(a) - i - 1):\n",
    "            comparisons += 1\n",
    "\n",
    "            if a[j] > a[j + 1]:\n",
    "                a[j], a[j + 1] = a[j + 1], a[j]\n",
    "                swaps += 1\n",
    "                swapped = True\n",
    "\n",
    "        if not swapped:\n",
    "            break\n",
    "\n",
    "    return a, comparisons, swaps\n",
    "\n",
    "\n",
    "data = [\n",
    "    (ID_SUM * 3) % 100,\n",
    "    (SEED_DIGIT * 11) % 100,\n",
    "    (NAME_LENGTH * 7) % 100,\n",
    "    42,\n",
    "    17,\n",
    "    89,\n",
    "    31,\n",
    "    56\n",
    "]\n",
    "\n",
    "bubble_result, bubble_comparisons, bubble_swaps = bubble_sort(data)\n",
    "\n",
    "print(\"Sorted:\", bubble_result)\n",
    "print(\"Comparisons:\", bubble_comparisons)\n",
    "print(\"Swaps:\", bubble_swaps)"
   ]
